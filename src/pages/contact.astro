---
import Layout from "@/layouts/Layout.astro";
import { getSettings } from "@/lib/content";

const settings = getSettings();
---

<Layout title="Contact" description="Get in touch about a commission.">
  <section class="container-prose pt-20">
    <h1 class="font-serif text-4xl md:text-5xl">Get in touch</h1>

    <div class="mt-8 space-y-5 leading-relaxed text-bark-800">
      <p>
        Most pieces are made on commission. If you have something in mind — a
        character, a costume, a photo shoot — write with the rough idea, the
        date you need it by, and any reference images.
      </p>
      <p>Reply usually within a few days.</p>
    </div>

    {
      settings.contactEmail ? (
        <div class="mt-10">
          <a
            href={`mailto:${settings.contactEmail}`}
            class="inline-block border-b border-tan-500 pb-1 font-serif text-2xl text-tan-600 hover:text-tan-700"
          >
            {settings.contactEmail}
          </a>
        </div>
      ) : (
        <p class="mt-10 text-sm text-bark-700/70">
          Contact email coming soon — add one in <code>src/content/settings.ts</code>.
        </p>
      )
    }

    {
      settings.socialLinks.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-6 text-sm uppercase tracking-wider">
          {settings.socialLinks.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-bark-700 hover:text-tan-600"
              >
                {s.platform}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
