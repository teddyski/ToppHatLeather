---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import { getAllProducts } from "@/lib/content";

const products = getAllProducts();
---

<Layout title="Work" description="The full collection of sculpted leather masks.">
  <section class="container-wide pt-16">
    <h1 class="font-serif text-4xl md:text-5xl">Work</h1>
    <p class="mt-3 max-w-prose text-bark-700">
      Each piece is built by hand, one at a time. No two are alike.
    </p>
  </section>

  <section class="container-wide mt-12">
    <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>
</Layout>
